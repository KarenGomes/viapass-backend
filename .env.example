# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Banco de dados (PostgreSQL) ─────────────────────────────────────────────
# Rodando via Docker Compose, DB_HOST é sobrescrito para `postgres` (nome do
# serviço). Este valor vale para rodar a API fora do contêiner.
#
# Em produção, DB_HOST é OBRIGATÓRIA: sem ela a aplicação recusa subir, em vez
# de assumir localhost e falhar depois com ECONNREFUSED.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=viapass
DB_PASSWORD=viapass_dev
DB_DATABASE=viapass

# Alternativa aos cinco campos acima: a connection string completa, no formato
# que Render, Fly, Railway e Heroku entregam pronta. Quando definida, vence.
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# TLS na conexão com o banco. Postgres gerenciado exige no endereço externo e
# dispensa no interno (mesma região). Padrão: false.
# DB_SSL=false

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Mínimo de 32 caracteres — a aplicação recusa subir com segredo curto.
# Gere com: openssl rand -hex 32
JWT_SECRET=troque-este-valor-por-um-segredo-de-no-minimo-32-caracteres
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-este-outro-valor-por-um-segredo-diferente-e-longo
JWT_REFRESH_EXPIRES_IN=7d

# ─── Assinatura do QR Code do ingresso ───────────────────────────────────────
# HMAC-SHA256. Trocar este valor invalida todos os ingressos já emitidos.
TICKET_HMAC_SECRET=troque-este-segredo-de-assinatura-dos-ingressos-tambem

# ─── Ticketmaster Discovery API ──────────────────────────────────────────────
# Chave gratuita em https://developer.ticketmaster.com
# Limites: 5 req/s, 5.000 req/dia, paginação profunda até size × page < 1000.
# Sem chave, a busca no catálogo devolve 503 — o resto da API funciona normal.
TM_API_KEY=
TM_API_BASE_URL=https://app.ticketmaster.com/discovery/v2

# ─── Front-end ───────────────────────────────────────────────────────────────
# Origem do Vite. Usada no CORS e para montar os links de compartilhamento.
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ─── Docker ──────────────────────────────────────────────────────────────────
# `development` (hot reload) ou `production` (JS compilado).
BUILD_TARGET=development
